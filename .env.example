# scraper_service/.env.example
# Copy to scraper_service/.env and fill in your values.

# ── Ollama LLM (keep in sync with your policy-scraper .env) ──────────────────
OLLAMA_BASE_URL=http://10.112.30.10:11434
OLLAMA_MODEL=ollama/phi4-mini-reasoning
SEARCH_PROMPT=Find URLs related to company policies, privacy policy, terms of service, data protection, cookie policy, acceptable use policy, and compliance documents.

# ── Absolute path to your existing policy-scraper folder ─────────────────────
# worker.py imports SitemapParser, URLFilter, ContentExtractor from there.
SCRAPER_DIR=/Users/yourname/policy-scraper

# ── Rails app base URL ────────────────────────────────────────────────────────
RAILS_API_URL=http://localhost:3000

# ── This service ──────────────────────────────────────────────────────────────
PORT=8088
